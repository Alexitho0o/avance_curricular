!control/reportes/resumen_historico_mu_2026.csv
!control/reportes/inventario_limpieza_mu_2026.tsv
!control/pendientes/backlog_residual_mu_2026.tsv
!archive/
!archive/**/
!archive/**/*.md
!archive/**/*.json
!archive/**/*.txt
!archive/**/*.log
!archive/**/*.py
!archive/**/*.csv
!archive/**/*.tsv
!archive/**/*.xlsx
*.parquet
*.zip
*.tar.gz
*.pkl
*.joblib

# Track matrix files
!matriz_desambiguacion_sies_final.tsv

# Ignore accidental Finder duplicates and Office temp files
* 2.*
~$*.xlsx

# Track grade conversion catalog
!gobernanza_escala_notas.tsv

# General OS files
.DS_Store

# --- SIES monorepo ---
procesos/*/output/*
__pycache__/
*.pyc
.pytest_cache/
.venv/
.DS_Store
~$*
!procesos/ire_2026/data/**/*.csv
!procesos/ire_2026/data/**/*.xlsm
!procesos/ire_2026/data/**/*.xlsx
