        "h3_codes",
        "h4_plans"
      ]
    },
    {
      "id": "H5-05",
      "area": "cobertura",
      "severity": "BLOQUEANTE",
      "requirement": "Distinguir ausencia fuera de cobertura, ausencia dentro de cobertura y ausencia de observaciones.",
