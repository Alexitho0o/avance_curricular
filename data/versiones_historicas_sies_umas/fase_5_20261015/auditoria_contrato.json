        "h3_annual",
        "annual_contract"
      ]
    },
    {
      "id": "H5-03",
      "area": "clave_anual",
      "severity": "BLOQUEANTE",
      "requirement": "Unir oferta y MRUN por año exacto más código único.",
      "acceptance": "No usar existencia de un código en otro año para rellenar oferta ausente; clave anual única y ausencia conservada.",
      "evidence": [
        "h3_contract",
        "h3_cross"
      ]
    },
    {
      "id": "H5-04",
      "area": "universo",
      "severity": "BLOQUEANTE",
      "requirement": "Mantener la unión de fuentes sin exigir matrícula ni actividad.",
      "acceptance": "141 códigos SIES; 35 solo oferta; dos solo MRUN heredados; 236 etiquetas de plan con 223 en catálogo y 13 solo PROMEDIOS.",
