   <row>
    <id><![CDATA[9395]]></id>
    <qid><![CDATA[10085]]></qid>
    <question><![CDATA[Sí, discapacidad física o motora (disminución o ausencia de las funciones motoras o físicas en el cuerpo, por ej. Problemas de movilidad o falta de una parte del cuerpo)]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[9165]]></id>
    <qid><![CDATA[9855]]></qid>
    <question><![CDATA[<p><span style="font-size:14px;"><span style="font-family:Verdana, Geneva, sans-serif;"><span style="line-height:107%;"><span style="color:#1f3864;">Indica tu nacionalidad.</span></span></span></span></p>

<p> </p>
]]></question>
    <help><![CDATA[<span style="font-size:14px;"><span style="font-family:Verdana, Geneva, sans-serif;"><span style="line-height:107%;"><span style="color:#1f3864;"><img alt="imagen de Cédula de identidad que describe la ubicación de la nacionalidad en el carnet de identidad" src="/upload/surveys/443299/images/T4.png" /></span></span></span></span>]]></help>
