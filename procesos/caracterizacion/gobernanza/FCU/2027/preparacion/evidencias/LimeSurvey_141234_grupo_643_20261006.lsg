   <row>
    <id><![CDATA[10771]]></id>
    <qid><![CDATA[11460]]></qid>
    <question><![CDATA[Sí, discapacidad física o motora (disminución o ausencia de las funciones motoras o físicas en el cuerpo, por ej. Problemas de movilidad o falta de una parte del cuerpo)]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[10718]]></id>
    <qid><![CDATA[11407]]></qid>
    <question><![CDATA[<p><span style="font-size:14px;"><span style="font-family:Verdana, Geneva, sans-serif;"><span style="line-height:107%;"><span style="color:#1f3864;">Indica tu nacionalidad.</span></span></span></span></p>

<p> </p>
]]></question>
    <help><![CDATA[<span style="font-size:14px;"><span style="font-family:Verdana, Geneva, sans-serif;"><span style="line-height:107%;"><span style="color:#1f3864;"><img alt="imagen de Cédula de identidad que describe la ubicación de la nacionalidad en el carnet de identidad" src="/upload/surveys/141234/images/T4.png" /></span></span></span></span>]]></help>
    <language><![CDATA[es]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[10772]]></id>
    <qid><![CDATA[11461]]></qid>
    <question><![CDATA[Sí, discapacidad auditiva (déficit total o parcial en la percepción auditiva que afecta a las funciones sensoriales como el oído y estructuras relacionadas)]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[10712]]></id>
    <qid><![CDATA[11401]]></qid>
    <question><![CDATA[<p><span style="font-family:Verdana, Geneva, sans-serif;"><span style="color:#1f3864;"><span style="font-size:14px;">¿Cuál es tu situación migratoria actualmente?</span></span></span></p>
]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
