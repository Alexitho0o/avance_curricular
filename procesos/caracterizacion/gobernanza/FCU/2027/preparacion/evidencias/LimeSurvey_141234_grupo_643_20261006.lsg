   <row>
    <id><![CDATA[10773]]></id>
    <qid><![CDATA[11462]]></qid>
    <question><![CDATA[Sí, discapacidad visual (afecciones de la vista como baja visión, limitación visual, agudeza visual, impedimento visual, percepción visual y ceguera. No se considera la necesidad de usar lentes ópticos)]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
   </row>
   <row>
    <id><![CDATA[10774]]></id>
    <qid><![CDATA[11463]]></qid>
    <question><![CDATA[Sí, discapacidad intelectual (limitaciones en las habilidades cognitivas diarias que una persona requiere y que le sirven para responder a distintas situaciones en la vida)]]></question>
    <help/>
    <language><![CDATA[es]]></language>
    <script/>
