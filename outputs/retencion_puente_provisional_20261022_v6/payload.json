[{"name": "29_Actualizacion_Provisional", "replace_index": 30, "rows": [["Retención IPSS V6 · contraste documental de las 63 dimensiones"], ["PENDIENTE_APROBACION_GOBERNANZA · 2026-10-22 · IPSS interno; no regla oficial SIES"], ["Retención histórica intacta. Personas, expedientes y dimensiones son universos distintos."], ["Indicador", "Base num.", "Denom.", "Base %", "Actual / escenario", "Denom.", "%", "Cambio comparable pp"], ["Pendientes bajo controles originales", 24, 63, null, 24, 63, null, 0], ["Nuevas recalificaciones acreditadas con TODOS los controles", 0, 63, null, 0, 63, null, 0], ["Indicador V4 contextual (criterio anterior)", null, null, null, 8, 63, null, null], ["Pendientes en escenario mixto NO APROBADO", null, null, null, 19, 63, null, null], ["Propuestas estadísticas heredadas, no equivalencias", 39, 63, null, 39, 63, null, 0], ["Equivalencias aprobadas demostradas", 0, 63, null, 0, 63, null, 0], [], ["Línea base", "24/63 = 38,10%. No hay recalificación nueva demostrada bajo TODOS los controles originales."], ["Escenario mixto", "19/63 = 30,16%: PROPUESTA_METODOLOGICA_NO_APROBADA. Mezcla 39 estadísticas y 5 contextuales; no avance comparable validado."], ["Indicadores distintos", "8/63 anterior exigía n3 y catálogo. Nuevo: 12/63 con código anual y contexto DA completos, sin n3/90; no comparación directa ni cierre de plan."], ["Límite contextual", "Cobertura de observaciones disponibles; no certifica vigencia individual del plan, conciliación exhaustiva MU ni regla prospectiva."], ["TCRE/J2", "80% de predominancia: NO pasa 90%. No se baja el umbral; contextual uno-a-varios pendiente de aprobación metodológica."], ["Otros cuatro", "NAUTRE/J2, NECIRE/J2, NICCREOL/J4, NINFREOL/J4: no están acreditados TODOS los controles originales."], ["Retención y privacidad", "Tasas y denominadores intactos; 13 gráficos preservados. Detalle personal excluido desde V1, históricos dependientes fijados."], ["Revisión ampliada", "5.901 personas; 6.622 expedientes; 24.774 observaciones. 4.885 con código en alguna fuente. Hojas 38 y 39."], ["Propuestas previas", "18.304 observaciones confirman código propuesto; 1.760 difieren. Diferencia documentada, sin modificar canon ni retención."]], "formulas": {"D5": "=B5/C5", "G5": "=E5/F5", "D6": "=B6/C6", "G6": "=E6/F6", "D9": "=B9/C9", "G9": "=E9/F9", "D10": "=B10/C10", "G10": "=E10/F10", "G7": "=E7/F7", "G8": "=E8/F8"}}, {"name": "38_Contraste_63_V6", "rows": [["Contraste documental completo · V6 · 63 dimensiones"], ["Mismo inventario multiproceso; universo ampliado. No inferir equivalencias por mayoría ni mínimo de personas."], ["Antes: 504 personas de 24 dimensiones pendientes. Ahora: todas las observaciones de las 63 dimensiones; denominadores distintos."], ["Indicador", "Numerador", "Denominador", "Proporción", "Interpretación"], ["Personas con código en alguna fuente", 4885, 5901, null, "Sin filtro previo por año ni familia"], ["Personas sin código completo localizado", 1016, 5901, null, "Ausencia dentro de fuentes verificadas"], ["Expedientes examinados", 6622, 6622, null, "Carrera interna + CODCLI; no sumar con personas"], ["Observaciones examinadas", 24774, 24774, null, "Identidad + expediente + plan del corte + año + periodo PR"], ["Confirma código propuesto previo", 18304, 24774, null, "Código observado único; contexto DA exacto"], ["Difiere de código propuesto previo", 1760, 24774, null, "Corrección descriptiva del código observado por contexto; no cambia propuesta general"], ["Código anual único sin propuesta previa", 1497, 24774, null, "No exige 90% ni tres personas; no acredita vigencia del plan"], ["Contradicción o atribución múltiple", 86, 24774, null, "Varios códigos o posibles expedientes/identidades; requiere revisión"], ["Sin evidencia anual aplicable", 3112, 24774, null, "Puede existir otro año/proceso; no se descarta esa evidencia histórica"], ["Código anual sin contexto DA exacto", 15, 24774, null, "No atribuir al expediente solo por identidad"], ["Dimensiones con código anual/contexto DA completos", 12, 63, null, "3 antes propuestas + 9 antes pendientes; no equivale a plan efectivo acreditado"], ["Dimensiones con plan efectivo acreditado", 0, 63, null, "No acreditado en esta prueba; no significa que las relaciones sean falsas"], ["Personas del universo previo con resultado conservado", 504, 504, null, "497 con código y 7 no localizadas: sin cambio al ampliar universo"], [], ["Regla temporal", "MU: año de matrícula explícito. Avance: año de carga/proceso no equivale automáticamente al año académico. Titulados: título no demuestra matrícula del año."], ["Plan", "PLAN_DE_ESTUDIO del extracto puede ser etiqueta del corte; no acredita por sí solo asignación histórica por periodo."], ["Estado documental", "Archivos Publicados/Enviados, precargas, borradores y derivados conservan etiqueta; ubicación no prueba aceptación individual."], ["Antes/después", "39 propuestas originales contrastadas, no aprobadas nuevamente. 12 dimensiones muestran diferencias en al menos una observación; 10 tienen contradicción/atribución múltiple."], ["Línea base", "24/63=38,10% permanece como línea base de propuestas originales. No restar automáticamente las 9 dimensiones con código contextual completo."], ["Privacidad", "Identificadores y enlaces fila a fila exclusivamente en el privado V3, fuera de Git; aquí solo agregados."], ["QA", "SQLite independiente verifica conjuntos de códigos de las 24.774 observaciones sobre proyecciones; no se atribuye segunda lectura de todos los originales."], ["Retención", "Sin cambios en tasas/denominadores, 13 gráficos históricos conservados. Desfase T3 heredado continúa documentado."]], "formulas": {"D5": "=B5/C5", "D6": "=B6/C6", "D7": "=B7/C7", "D8": "=B8/C8", "D9": "=B9/C9", "D10": "=B10/C10", "D11": "=B11/C11", "D12": "=B12/C12", "D13": "=B13/C13", "D14": "=B14/C14", "D15": "=B15/C15", "D16": "=B16/C16", "D17": "=B17/C17"}}, {"name": "39_Dimensiones_Contraste", "rows": [["Contraste agregado de las 63 dimensiones"], 